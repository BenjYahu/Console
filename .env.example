# Optional. Accounts, display names and allowed commands live in ServerData.go, and a listed account
# normally needs nothing here: the API verifies the client's own Minecraft login.
#
# These are only a fallback for launchers that hand the game no live login. One variable per
# account, named CONSOLE_TOKEN_<USERNAME> unless the account sets TokenEnv.
# Generate each with: openssl rand -hex 32
CONSOLE_TOKEN_POOP656=
CONSOLE_TOKEN_LAIN=

# Required on Vercel: serverless instances share no memory, so events need a shared store.
# Vercel KV and Upstash both expose these REST variables.
KV_REST_API_URL=
KV_REST_API_TOKEN=
