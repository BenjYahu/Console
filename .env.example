# Copy to .env (never commit it) or, on Vercel, use Project → Settings → Environment Variables.
#
# Accounts, display names and allowed commands live in ServerData.go. Only their tokens go here:
# one variable per account, named CONSOLE_TOKEN_<USERNAME> unless the account sets TokenEnv.
# Generate each with: openssl rand -hex 32

CONSOLE_TOKEN_POOP656=
CONSOLE_TOKEN_LAIN=

# Optional shared store. Without it events live in one instance's memory, which is fine locally
# but wrong on serverless: a command posted to one instance would never reach a poll hitting
# another. Vercel KV and Upstash both expose these REST variables.
KV_REST_API_URL=
KV_REST_API_TOKEN=
